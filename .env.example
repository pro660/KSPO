# Server-side upstream. Browser requests use /gateway on the frontend origin.
CHECHE_API_BASE_URL=http://localhost:8080
# Existing NEXT_PUBLIC_CHECHE_API_BASE_URL is still supported as a fallback.
# Set only one upstream variable. If both exist, CHECHE_API_BASE_URL wins.
# Explicit opt-in preview using local sample data. Never enabled automatically.
NEXT_PUBLIC_CHECHE_DEMO_MODE=false
# Temporarily allow page access without frontend authentication guards.
NEXT_PUBLIC_CHECHE_DISABLE_AUTH_GUARD=false
